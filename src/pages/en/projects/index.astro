---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FilterTabs from "@components/FilterTabs.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { PROJECTS_EN as PROJECTS } from "@consts";
import { getIconMap, idToSlug } from "@lib/utils";

const projects = (await getCollection("projects-en"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const icons = getIconMap(import.meta.glob("/src/assets/projects/*/icon.*", { eager: true }) as Record<string, { default: { src: string } }>);

---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Projects
      </div>
      <FilterTabs
        ariaLabel="Filter projects by type"
        tabs={[
          { value: "all", label: "All" },
          { value: "professional", label: "Professional" },
          { value: "personal", label: "Personal" },
        ]}
      />
      <ul id="project-list" class="animate flex flex-col gap-4">
        {
          projects.map((project) => (
            <li data-filter-show={`all ${project.data.type}`}>
              <ArrowCard entry={project} href={`/en/projects/${idToSlug(project.id)}`} icon={icons[idToSlug(project.id)]} tag={project.data.type} />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
